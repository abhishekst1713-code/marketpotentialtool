# Backend (Express) — copy to server/.env and fill in your values.

PORT=4000
NODE_ENV=development

# Required — get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-flash

# Required — Settings → API in your Supabase project
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Origin allowed to call this API (your Vite dev server / deployed frontend)
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# ── Razorpay — optional for now ──────────────────────────────────
# The payment gateway is disabled in the app (report unlocks instantly,
# for free). These are only needed if/when the Razorpay checkout flow in
# src/pages/AssessmentAndDashboard.jsx is re-enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Redirect URLs ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PAYMENT_HUB_URL=https://payment-t1ag.onrender.com/?app_id=cofit
