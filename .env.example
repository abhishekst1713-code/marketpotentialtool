# Frontend (Vite) — copy to .env and fill in your values.
# Only used for Supabase Auth on the client; all other Supabase access
# goes through the backend's service-role key.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Base URL of the backend API. Leave blank for local dev — Vite proxies
# /api to http://localhost:4000 automatically (see vite.config.js).
# Set this to your deployed backend URL in production.
VITE_API_URL=

# Payment Hub base URL — only relevant once the Razorpay flow is
# re-enabled in src/pages/AssessmentAndDashboard.jsx.
VITE_PAYMENT_HUB_URL=https://payment-t1ag.onrender.com/?app_id=cofit
